$bog_tox_fs_home $mol_list
	sub /
		<= Header $mol_text
			text \The TOX File Service
		<= Auth $mol_list
			rows <= auth_rows /
		<= Editor_link $mol_link
			title @ \Open editor
			arg * page \editor
		<= FileDirectoryList $mol_list
			rows <= file_directories /
	Auth_label $mol_text
		text <= auth_label \
	Login $mol_button_minor
		title \Log in
		click? <=> login? null
	Logout $mol_button_minor
		title \Log out
		click? <=> logout? null
